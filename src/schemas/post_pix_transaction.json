{
  "title": "PostPixTransaction",
  "type": "object",
  "properties": {
    "id": {
      "description": "Volta no endereço do GET (/pix/transaction/{id}): só o que cabe num endereço sem codificação.",
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,100}$"
    },
    "amount": {
      "description": "Centavos. O máximo é o maior número que cabe na coluna BIGINT: acima dele, o banco recusaria a gravação.",
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "transaction_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$" },
    "source_account": {
      "type": "object",
      "properties": {
        "branch": { "type": "string", "pattern": "^[0-9]{1,10}$" },
        "account_number": { "type": "string", "pattern": "^[0-9A-Za-z-]{1,20}$" },
        "opening_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$" },
        "owner": {
          "type": "object",
          "properties": {
            "document_number": { "type": "string", "pattern": "^([0-9]{3}\\.[0-9]{3}\\.[0-9]{3}-[0-9]{2}|[0-9]{11}|[0-9]{2}\\.[0-9]{3}\\.[0-9]{3}/[0-9]{4}-[0-9]{2}|[0-9]{14})$" }
          },
          "required": ["document_number"],
          "additionalProperties": false
        }
      },
      "required": ["branch", "account_number", "opening_date", "owner"],
      "additionalProperties": false
    },
    "destination_account": {
      "type": "object",
      "properties": {
        "participant": {
          "description": "ISPB: oito dígitos.",
          "type": "string",
          "pattern": "^[0-9]{8}$"
        },
        "branch": { "type": "string", "pattern": "^[0-9]{1,10}$" },
        "account_number": { "type": "string", "pattern": "^[0-9A-Za-z-]{1,20}$" },
        "opening_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$" },
        "owner": {
          "type": "object",
          "properties": {
            "document_number": { "type": "string", "pattern": "^([0-9]{3}\\.[0-9]{3}\\.[0-9]{3}-[0-9]{2}|[0-9]{11}|[0-9]{2}\\.[0-9]{3}\\.[0-9]{3}/[0-9]{4}-[0-9]{2}|[0-9]{14})$" }
          },
          "required": ["document_number"],
          "additionalProperties": false
        }
      },
      "required": ["participant", "branch", "account_number", "opening_date", "owner"],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "device_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "channel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "ip": {
          "description": "IPv4 ou IPv6: só dígitos hexadecimais, pontos e dois-pontos.",
          "type": "string",
          "pattern": "^[0-9A-Fa-f:.]{2,45}$"
        },
        "geolocation": {
          "type": "object",
          "properties": {
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "required": ["latitude", "longitude"],
          "additionalProperties": false
        }
      },
      "required": ["device_id", "channel", "ip"],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "amount",
    "transaction_date",
    "source_account",
    "destination_account",
    "source"
  ],
  "additionalProperties": false
}
